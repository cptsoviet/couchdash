<?xml version="1.0" encoding="utf-8"?>
<!-- CouchDash: launch screen = the launcher's dark gradient + the centred logo block (branding/, 4x PNG, sharp at 4K) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#10141B"
                android:startColor="#232B3A" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
